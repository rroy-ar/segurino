# Firebase configuration
FIREBASE_DATABASE_URL=https://your-project-id-default-rtdb.firebaseio.com/
FIREBASE_SERVICE_ACCOUNT_PATH=./serviceAccountKey.json

# Gmail SMTP configuration (use a Google App Password, not your account password)
GMAIL_USER=your-alert-sender@gmail.com
GMAIL_APP_PASSWORD=xxxx xxxx xxxx xxxx

# Comma-separated list of internal/device emails excluded from alert notifications
EXCLUDED_EMAILS=device-account@example.com,server@example.com
